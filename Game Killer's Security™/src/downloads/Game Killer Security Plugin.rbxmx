		<Item class="Script" referent="RBXA6A19FC0ABEE4AA98EFAFD61EBDC3032">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
    Game Killers Security™ - Configuration Module
    Version: 2.5.3
    
    ⚠️ IMPORTANT: Configure your server's API key below!
    
    HOW TO GET YOUR API KEY:
    1. Go to https://www.gamekillersecuritybot.com/dashboard
    2. Login with Discord
    3. Select your Discord server
    4. Copy the API key shown on the dashboard
    5. Paste it below on line 29
    
    Your API key is unique to YOUR Discord server!
]]

local Configuration = {}

-- ========================================
-- ⚠️ REQUIRED: API KEY CONFIGURATION
-- ========================================
--[[
    🔑 YOUR SERVER'S API KEY
    
    Each Discord server has its own unique API key.
    This connects your Roblox game to YOUR Discord server's bot.
    
    Example: Configuration.API_KEY = "gks_1234567890_1234567890_abc123def456"
]]

Configuration.API_URL = "http://23.27.211.92:25230"
Configuration.API_KEY = "YOUR_API_KEY_HERE"  -- ⚠️ PASTE YOUR SERVER'S API KEY HERE!

-- Quick validation check
if Configuration.API_KEY == "YOUR_API_KEY_HERE" or Configuration.API_KEY == "" then
	warn("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
	warn("⚠️  GAME KILLERS SECURITY - SETUP REQUIRED")
	warn("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
	warn("❌ API Key not configured!")
	warn("")
	warn("📋 To get YOUR SERVER'S API key:")
	warn("   1. Visit: https://www.gamekillersecuritybot.com/dashboard")
	warn("   2. Login with Discord")
	warn("   3. Select YOUR Discord server from the list")
	warn("   4. Copy the unique API key shown")
	warn("   5. Paste it in Configuration.lua on line 29")
	warn("")
	warn("💡 Each Discord server has its own unique API key!")
	warn("🛡️ Security features will be LIMITED until configured")
	warn("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
end

-- ========================================
-- SENSITIVITY SETTINGS
-- ========================================
-- Options: "Low", "Medium", "High"
-- Low = More lenient, fewer false positives
-- Medium = Balanced (recommended for most games)
-- High = Very strict, may have false positives
Configuration.SENSITIVITY = "Medium"

-- Detection thresholds based on sensitivity
local THRESHOLDS = {
	Low = {
		SPEED_THRESHOLD = 10,
		MAX_DISTANCE_PER_SECOND = 200,
		JUMP_THRESHOLD = 30,
		MAX_VIOLATIONS = 5,
		CHECK_INTERVAL = 2
	},
	Medium = {
		SPEED_THRESHOLD = 5,
		MAX_DISTANCE_PER_SECOND = 150,
		JUMP_THRESHOLD = 20,
		MAX_VIOLATIONS = 3,
		CHECK_INTERVAL = 1
	},
	High = {
		SPEED_THRESHOLD = 2,
		MAX_DISTANCE_PER_SECOND = 100,
		JUMP_THRESHOLD = 10,
		MAX_VIOLATIONS = 2,
		CHECK_INTERVAL = 0.5
	}
}

-- Apply selected sensitivity
local selectedThreshold = THRESHOLDS[Configuration.SENSITIVITY] or THRESHOLDS.Medium

Configuration.SPEED_THRESHOLD = selectedThreshold.SPEED_THRESHOLD
Configuration.MAX_DISTANCE_PER_SECOND = selectedThreshold.MAX_DISTANCE_PER_SECOND
Configuration.JUMP_THRESHOLD = selectedThreshold.JUMP_THRESHOLD
Configuration.MAX_VIOLATIONS = selectedThreshold.MAX_VIOLATIONS
Configuration.CHECK_INTERVAL = selectedThreshold.CHECK_INTERVAL

-- ========================================
-- DEFAULT CHARACTER VALUES
-- ========================================
Configuration.DEFAULT_WALKSPEED = 16
Configuration.DEFAULT_JUMPPOWER = 50
Configuration.MAX_HEALTH = 100

-- ========================================
-- BAN & KICK SETTINGS
-- ========================================
Configuration.AUTO_BAN = true  -- Automatically ban detected exploiters
Configuration.BAN_MESSAGE = "🛡️ Game Killers Security™\n\nYou have been banned from this game.\nReason: %s\n\nAppeal at: discord.gg/gamekilllers"
Configuration.KICK_MESSAGE = "🛡️ Game Killers Security™\n\nYou have been removed from this game.\nReason: %s"

-- ========================================
-- DISCORD INTEGRATION
-- ========================================
-- Note: These features require a valid API key
Configuration.DISCORD_ALERTS = true  -- Send real-time alerts to Discord
Configuration.ALERT_ON_JOIN = false  -- Alert when suspicious players join
Configuration.ALERT_ON_THREAT = true  -- Alert on threat detection

-- ========================================
-- WHITELIST
-- ========================================
-- Add user IDs of players who should bypass all checks
-- Perfect for developers, testers, and trusted staff
-- Example: 123456789, 987654321
Configuration.WHITELIST = {
	-- Add your Roblox User IDs here
}

-- ========================================
-- ADMIN COMMANDS
-- ========================================
-- User IDs who can use /gk commands in-game
-- These users can ban, kick, and manage security
Configuration.ADMIN_IDS = {
	-- Add your Roblox User IDs here
}

-- ========================================
-- ADVANCED SETTINGS
-- ========================================
Configuration.LOG_LEVEL = "INFO"  -- Options: "INFO", "WARN", "ERROR"
Configuration.MAX_THREAT_LOG_SIZE = 100  -- Maximum threats to store in memory
Configuration.STATS_UPDATE_INTERVAL = 300  -- Send stats to API every 5 minutes (seconds)

-- ========================================
-- DETECTION TOGGLES
-- ========================================
-- Enable or disable specific detection systems
Configuration.DETECT_SPEED = true      -- Speed hack detection
Configuration.DETECT_TELEPORT = true   -- Teleport hack detection
Configuration.DETECT_JUMP = true       -- Jump exploit detection
Configuration.DETECT_HEALTH = true     -- Health exploit detection
Configuration.DETECT_FLY = false       -- Fly hack detection (coming soon)

-- ========================================
-- CUSTOM MESSAGES
-- ========================================
Configuration.THREAT_DETECTED_MESSAGE = "⚠️ Security violation detected. Adjusting parameters..."
Configuration.WARNING_MESSAGE = "⚠️ Warning: Suspicious activity detected. Further violations will result in removal."

-- ========================================
-- PERFORMANCE SETTINGS
-- ========================================
Configuration.OPTIMIZATION_MODE = false  -- Enable for large servers (reduces check frequency)
Configuration.MAX_PLAYERS_FOR_FULL_MONITORING = 50  -- Above this, optimization mode auto-enables

-- ========================================
-- VALIDATION FUNCTION
-- ========================================
function Configuration.Validate()
	local valid = true
	local warnings = {}

	-- Check API key format
	if Configuration.API_KEY == "YOUR_API_KEY_HERE" or Configuration.API_KEY == "" then
		table.insert(warnings, "⚠️ API Key not set! Get your server's key from: https://www.gamekillersecuritybot.com/dashboard")
		valid = false
	elseif not string.match(Configuration.API_KEY, "^gks_") then
		table.insert(warnings, "⚠️ API Key format invalid! Make sure you copied the complete key.")
		valid = false
	end

	-- Check API URL
	if not Configuration.API_URL or Configuration.API_URL == "" then
		table.insert(warnings, "⚠️ API URL not configured!")
		valid = false
	end

	-- Check sensitivity
	if not THRESHOLDS[Configuration.SENSITIVITY] then
		table.insert(warnings, "⚠️ Invalid sensitivity level! Using Medium.")
		Configuration.SENSITIVITY = "Medium"
	end

	-- Validate thresholds
	if Configuration.SPEED_THRESHOLD < 0 then
		table.insert(warnings, "⚠️ Invalid speed threshold! Using default.")
		Configuration.SPEED_THRESHOLD = 5
	end

	if Configuration.MAX_VIOLATIONS < 1 then
		table.insert(warnings, "⚠️ Invalid max violations! Using default.")
		Configuration.MAX_VIOLATIONS = 3
	end

	-- Print warnings
	if #warnings > 0 then
		warn("\n=== Game Killers Security Configuration Warnings ===")
		for _, warning in ipairs(warnings) do
			warn(warning)
		end
		warn("===================================================\n")
	end

	return valid
end

-- ========================================
-- HELPER FUNCTIONS
-- ========================================

function Configuration.GetSensitivityInfo()
	return {
		Current = Configuration.SENSITIVITY,
		SpeedThreshold = Configuration.SPEED_THRESHOLD,
		TeleportThreshold = Configuration.MAX_DISTANCE_PER_SECOND,
		JumpThreshold = Configuration.JUMP_THRESHOLD,
		MaxViolations = Configuration.MAX_VIOLATIONS,
		CheckInterval = Configuration.CHECK_INTERVAL
	}
end

function Configuration.SetSensitivity(level)
	if THRESHOLDS[level] then
		Configuration.SENSITIVITY = level
		local threshold = THRESHOLDS[level]
		Configuration.SPEED_THRESHOLD = threshold.SPEED_THRESHOLD
		Configuration.MAX_DISTANCE_PER_SECOND = threshold.MAX_DISTANCE_PER_SECOND
		Configuration.JUMP_THRESHOLD = threshold.JUMP_THRESHOLD
		Configuration.MAX_VIOLATIONS = threshold.MAX_VIOLATIONS
		Configuration.CHECK_INTERVAL = threshold.CHECK_INTERVAL
		return true
	end
	return false
end

function Configuration.IsWhitelisted(userId)
	for _, id in ipairs(Configuration.WHITELIST) do
		if id == userId then
			return true
		end
	end
	return false
end

function Configuration.IsAdmin(userId)
	for _, id in ipairs(Configuration.ADMIN_IDS) do
		if id == userId then
			return true
		end
	end
	return false
end

function Configuration.AddToWhitelist(userId)
	if not Configuration.IsWhitelisted(userId) then
		table.insert(Configuration.WHITELIST, userId)
		return true
	end
	return false
end

function Configuration.RemoveFromWhitelist(userId)
	for i, id in ipairs(Configuration.WHITELIST) do
		if id == userId then
			table.remove(Configuration.WHITELIST, i)
			return true
		end
	end
	return false
end

function Configuration.AddAdmin(userId)
	if not Configuration.IsAdmin(userId) then
		table.insert(Configuration.ADMIN_IDS, userId)
		return true
	end
	return false
end

function Configuration.RemoveAdmin(userId)
	for i, id in ipairs(Configuration.ADMIN_IDS) do
		if id == userId then
			table.remove(Configuration.ADMIN_IDS, i)
			return true
		end
	end
	return false
end

-- ========================================
-- API KEY INFO
-- ========================================

function Configuration.GetAPIKeyInfo()
	if Configuration.API_KEY == "YOUR_API_KEY_HERE" or Configuration.API_KEY == "" then
		return {
			configured = false,
			message = "API key not configured. Get yours at: https://www.gamekillersecuritybot.com/dashboard"
		}
	end

	-- Extract basic info from key
	local parts = {}
	for part in string.gmatch(Configuration.API_KEY, "[^_]+") do
		table.insert(parts, part)
	end

	if #parts < 3 or parts[1] ~= "gks" then
		return {
			configured = true,
			valid = false,
			message = "API key format is invalid. Please check and reconfigure."
		}
	end

	return {
		configured = true,
		valid = true,
		guildId = parts[2],
		message = "API key configured successfully!"
	}
end

-- ========================================
-- EXPORT
-- ========================================
return Configuration
]]></ProtectedString>
