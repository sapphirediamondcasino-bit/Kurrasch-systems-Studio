<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBXC3067605CACF4D81BCF181F59B906E42">
		<Properties>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">Game Killer Security Plugin</string>
			<int64 name="SourceAssetId">-1</int64>
			<BinaryString name="Tags"></BinaryString>
		</Properties>
		<Item class="Script" referent="RBX80E2AB698AE948CAA8E1B1E2C18970D8">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
    Game Killers Security™ - Main Security Module
    Version: 2.5.3
    Created by: Game Killers Studios
    
    This script provides comprehensive anti-exploit protection for your Roblox game.
    Features: Speed hack detection, teleport prevention, exploit monitoring, auto-ban system
    
    Commands: Type /gk help in chat to see all available commands
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Import Configuration
local Config = require(script.Configuration)

-- Initialize API
local API_URL = Config.API_URL
local API_KEY = Config.API_KEY

-- Storage
local PlayerData = {}
local BannedPlayers = {}
local ThreatLog = {}
local Statistics = {
	ThreatsDetected = 0,
	PlayersKicked = 0,
	PlayersBanned = 0,
	GameStartTime = os.time()
}

-- ========================================
-- UTILITY FUNCTIONS
-- ========================================

local function Log(message, level)
	level = level or "INFO"
	local timestamp = os.date("%H:%M:%S")
	print(string.format("[Game Killers Security] [%s] %s: %s", timestamp, level, message))
end

local function SendToAPI(endpoint, data)
	if not API_KEY or API_KEY == "YOUR_API_KEY_HERE" or API_KEY == "" then
		return false
	end

	data.apiKey = API_KEY

	local success, result = pcall(function()
		local url = API_URL .. endpoint
		local payload = HttpService:JSONEncode(data)

		local response = HttpService:PostAsync(url, payload, Enum.HttpContentType.ApplicationJson, false)

		return HttpService:JSONDecode(response)
	end)

	if not success then
		warn("[Game Killers Security] API Error:", result)
		return false
	end

	return result
end

local function ReportThreat(player, threatType, details, severity)
	Statistics.ThreatsDetected = Statistics.ThreatsDetected + 1

	local threatData = {
		gameId = game.GameId,
		gameName = game.Name,
		placeId = game.PlaceId,
		userId = player.UserId,
		username = player.Name,
		displayName = player.DisplayName,
		threatType = threatType,
		details = details,
		severity = severity or "Medium",
		timestamp = os.time()
	}

	table.insert(ThreatLog, threatData)

	-- Keep log size manageable
	if #ThreatLog > Config.MAX_THREAT_LOG_SIZE then
		table.remove(ThreatLog, 1)
	end

	if Config.DISCORD_ALERTS and API_KEY and API_KEY ~= "YOUR_API_KEY_HERE" then
		SendToAPI("/api/roblox/threat", threatData)
	end

	Log(string.format("Threat detected: %s - Player: %s (%s)", threatType, player.Name, details), "WARN")
end

local function CheckBanStatus(player)
	if not API_KEY or API_KEY == "YOUR_API_KEY_HERE" or API_KEY == "" then
		return false
	end

	local response = SendToAPI("/api/roblox/ban-status", {
		userId = player.UserId,
		username = player.Name,
		gameId = game.GameId
	})

	if response and response.banned then
		return true, response.reason or "Violation of security policies"
	end

	return false, nil
end

local function BanPlayer(player, reason, violations)
	Statistics.PlayersBanned = Statistics.PlayersBanned + 1
	BannedPlayers[player.UserId] = {
		Username = player.Name,
		Reason = reason,
		Timestamp = os.time(),
		Violations = violations
	}

	if API_KEY and API_KEY ~= "YOUR_API_KEY_HERE" then
		SendToAPI("/api/roblox/ban-report", {
			gameId = game.GameId,
			gameName = game.Name,
			placeId = game.PlaceId,
			userId = player.UserId,
			username = player.Name,
			displayName = player.DisplayName,
			reason = reason,
			violations = violations,
			timestamp = os.time()
		})
	end

	player:Kick(string.format(Config.BAN_MESSAGE, reason))
	Log(string.format("Player banned: %s - Reason: %s", player.Name, reason), "WARN")
end

local function KickPlayer(player, reason)
	Statistics.PlayersKicked = Statistics.PlayersKicked + 1
	player:Kick(string.format(Config.KICK_MESSAGE, reason))
	Log(string.format("Player kicked: %s - Reason: %s", player.Name, reason), "WARN")
end

-- ========================================
-- DETECTION HELPER FUNCTIONS
-- ========================================

local function IsPlayerInVehicle(player)
	if not player.Character then return false end
	local humanoid = player.Character:FindFirstChild("Humanoid")
	if humanoid and humanoid.SeatPart then
		return true
	end
	return false
end

local function IsWhitelisted(player)
	return Config.IsWhitelisted(player.UserId)
end

-- ========================================
-- EXPLOIT DETECTION FUNCTIONS
-- ========================================

local function DetectSpeedHack(player)
	if not Config.DETECT_SPEED then return end
	if not player.Character then return end
	if IsPlayerInVehicle(player) then return end
	if IsWhitelisted(player) then return end

	local humanoid = player.Character:FindFirstChild("Humanoid")
	if not humanoid then return end

	local data = PlayerData[player.UserId]
	if not data then return end

	local currentSpeed = humanoid.WalkSpeed
	local expectedSpeed = Config.DEFAULT_WALKSPEED

	if currentSpeed > expectedSpeed + Config.SPEED_THRESHOLD then
		data.speedViolations = data.speedViolations + 1

		ReportThreat(player, "Speed Hack", 
			string.format("WalkSpeed: %.1f (Expected: %.1f)", currentSpeed, expectedSpeed), 
			"High")

		humanoid.WalkSpeed = expectedSpeed

		if data.speedViolations >= Config.MAX_VIOLATIONS then
			if Config.AUTO_BAN then
				BanPlayer(player, "Speed Hack Detection", data.speedViolations)
			else
				KickPlayer(player, "Speed Hack Detection")
			end
		end
	end
end

local function DetectTeleportHack(player)
	if not Config.DETECT_TELEPORT then return end
	if not player.Character then return end
	if IsPlayerInVehicle(player) then return end
	if IsWhitelisted(player) then return end

	local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end

	local data = PlayerData[player.UserId]
	if not data or not data.lastPosition then
		data.lastPosition = humanoidRootPart.Position
		data.lastPositionTime = tick()
		return
	end

	local currentPosition = humanoidRootPart.Position
	local distance = (currentPosition - data.lastPosition).Magnitude
	local timeDelta = tick() - (data.lastPositionTime or tick())

	local maxDistance = Config.MAX_DISTANCE_PER_SECOND * timeDelta

	if distance > maxDistance and timeDelta > 0.5 then
		data.teleportViolations = data.teleportViolations + 1

		ReportThreat(player, "Teleport Hack", 
			string.format("Distance: %.1f studs in %.2fs (Max: %.1f)", distance, timeDelta, maxDistance), 
			"High")

		humanoidRootPart.CFrame = CFrame.new(data.lastPosition)

		if data.teleportViolations >= Config.MAX_VIOLATIONS then
			if Config.AUTO_BAN then
				BanPlayer(player, "Teleport Hack Detection", data.teleportViolations)
			else
				KickPlayer(player, "Teleport Hack Detection")
			end
		end
	end

	data.lastPosition = currentPosition
	data.lastPositionTime = tick()
end

local function DetectJumpExploit(player)
	if not Config.DETECT_JUMP then return end
	if not player.Character then return end
	if IsWhitelisted(player) then return end

	local humanoid = player.Character:FindFirstChild("Humanoid")
	if not humanoid then return end

	local data = PlayerData[player.UserId]
	if not data then return end

	local currentJumpPower = humanoid.JumpPower or humanoid.JumpHeight
	local expectedJump = Config.DEFAULT_JUMPPOWER

	if currentJumpPower > expectedJump + Config.JUMP_THRESHOLD then
		data.jumpViolations = data.jumpViolations + 1

		ReportThreat(player, "Jump Exploit", 
			string.format("JumpPower: %.1f (Expected: %.1f)", currentJumpPower, expectedJump), 
			"Medium")

		if humanoid.JumpPower then
			humanoid.JumpPower = expectedJump
		else
			humanoid.JumpHeight = expectedJump
		end

		if data.jumpViolations >= Config.MAX_VIOLATIONS * 2 then
			if Config.AUTO_BAN then
				BanPlayer(player, "Jump Exploit Detection", data.jumpViolations)
			else
				KickPlayer(player, "Jump Exploit Detection")
			end
		end
	end
end

local function DetectHealthExploit(player)
	if not Config.DETECT_HEALTH then return end
	if not player.Character then return end
	if IsWhitelisted(player) then return end

	local humanoid = player.Character:FindFirstChild("Humanoid")
	if not humanoid then return end

	local data = PlayerData[player.UserId]
	if not data then return end

	if humanoid.MaxHealth > Config.MAX_HEALTH then
		data.healthViolations = data.healthViolations + 1

		ReportThreat(player, "Health Exploit", 
			string.format("MaxHealth: %.1f (Expected: %.1f)", humanoid.MaxHealth, Config.MAX_HEALTH), 
			"Medium")

		humanoid.MaxHealth = Config.MAX_HEALTH
		humanoid.Health = math.min(humanoid.Health, Config.MAX_HEALTH)

		if data.healthViolations >= Config.MAX_VIOLATIONS then
			if Config.AUTO_BAN then
				BanPlayer(player, "Health Exploit Detection", data.healthViolations)
			else
				KickPlayer(player, "Health Exploit Detection")
			end
		end
	end
end

-- ========================================
-- PLAYER MANAGEMENT
-- ========================================

local function OnPlayerAdded(player)
	local isBanned, reason = CheckBanStatus(player)
	if isBanned then
		player:Kick(string.format(Config.BAN_MESSAGE, reason))
		return
	end

	if BannedPlayers[player.UserId] then
		player:Kick(string.format(Config.BAN_MESSAGE, BannedPlayers[player.UserId].Reason))
		return
	end

	PlayerData[player.UserId] = {
		joinTime = tick(),
		speedViolations = 0,
		teleportViolations = 0,
		jumpViolations = 0,
		healthViolations = 0,
		lastPosition = nil,
		lastPositionTime = tick()
	}

	Log(string.format("Player joined: %s (ID: %d)", player.Name, player.UserId), "INFO")

	player.CharacterAdded:Connect(function(character)
		wait(1)

		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid then
			humanoid.WalkSpeed = Config.DEFAULT_WALKSPEED
			humanoid.JumpPower = Config.DEFAULT_JUMPPOWER
			humanoid.MaxHealth = Config.MAX_HEALTH
			humanoid.Health = Config.MAX_HEALTH

			humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				DetectSpeedHack(player)
			end)

			humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
				DetectJumpExploit(player)
			end)

			humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
				DetectHealthExploit(player)
			end)
		end

		local hrp = character:WaitForChild("HumanoidRootPart", 5)
		if hrp and PlayerData[player.UserId] then
			PlayerData[player.UserId].lastPosition = hrp.Position
			PlayerData[player.UserId].lastPositionTime = tick()
		end
	end)
end

local function OnPlayerRemoving(player)
	PlayerData[player.UserId] = nil
	Log(string.format("Player left: %s", player.Name), "INFO")
end

-- ========================================
-- MAIN DETECTION LOOP
-- ========================================

local lastCheck = tick()
RunService.Heartbeat:Connect(function()
	local now = tick()

	if now - lastCheck >= Config.CHECK_INTERVAL then
		lastCheck = now

		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				DetectTeleportHack(player)
			end
		end
	end
end)

-- ========================================
-- COMMAND SYSTEM
-- ========================================

local CommandPrefix = "/gk"

local function SendCommandToAPI(commandName, args, player)
	if not API_KEY or API_KEY == "YOUR_API_KEY_HERE" or API_KEY == "" then
		return {
			success = false,
			message = "⚠️ API not configured. Commands unavailable.\n\nGet your API key from:\nhttps://www.gamekillersecuritybot.com/dashboard"
		}
	end

	local response = SendToAPI("/api/roblox/command", {
		command = commandName,
		args = args,
		userId = player.UserId,
		username = player.Name,
		gameId = game.GameId
	})

	return response or { success = false, message = "Failed to connect to bot API" }
end

local function ShowMessage(player, message)
	local gui = player:FindFirstChild("PlayerGui")
	if not gui then return end

	local existing = gui:FindFirstChild("GKMessage")
	if existing then existing:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "GKMessage"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = gui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 500, 0, 200)
	frame.Position = UDim2.new(0.5, -250, 0.1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
	frame.BorderSizePixel = 0
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(168, 85, 247)
	stroke.Thickness = 2
	stroke.Parent = frame

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, -20, 1, -20)
	textLabel.Position = UDim2.new(0, 10, 0, 10)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = message
	textLabel.TextColor3 = Color3.fromRGB(229, 231, 235)
	textLabel.TextSize = 16
	textLabel.TextWrapped = true
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.TextYAlignment = Enum.TextYAlignment.Top
	textLabel.Font = Enum.Font.Code
	textLabel.Parent = frame

	task.delay(10, function()
		if screenGui and screenGui.Parent then
			screenGui:Destroy()
		end
	end)
end

local Commands = {
	help = function(player, args)
		local helpText = "🛡️ Game Killers Security™ Commands\n" ..
			"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n" ..
			"/gk help - Show this message\n" ..
			"/gk stats - View bot & game statistics\n" ..
			"/gk check <player> - Check player status\n" ..
			"/gk ban <player> <reason> - Ban a player\n" ..
			"/gk unban <player> - Unban a player\n" ..
			"/gk kick <player> <reason> - Kick a player\n" ..
			"/gk warn <player> <reason> - Warn a player\n" ..
			"/gk whitelist add <player> - Add to whitelist\n" ..
			"/gk whitelist remove <player> - Remove from whitelist\n" ..
			"/gk reset <player> - Reset violations\n" ..
			"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

		ShowMessage(player, helpText)
	end,

	stats = function(player, args)
		local uptime = os.time() - Statistics.GameStartTime
		local response = SendCommandToAPI("stats", args, player)

		local statsText = response.message or string.format(
			"📊 Statistics\n" ..
				"━━━━━━━━━━━━━━━━━━━━\n" ..
				"Threats Detected: %d\n" ..
				"Players Kicked: %d\n" ..
				"Players Banned: %d\n" ..
				"Game Uptime: %d seconds\n" ..
				"Active Players: %d\n" ..
				"Status: Protected ✅",
			Statistics.ThreatsDetected,
			Statistics.PlayersKicked,
			Statistics.PlayersBanned,
			uptime,
			#Players:GetPlayers()
		)

		ShowMessage(player, statsText)
	end,

	check = function(player, args)
		if not args[1] then
			ShowMessage(player, "❌ Usage: /gk check <player>")
			return
		end

		local response = SendCommandToAPI("check", args, player)
		ShowMessage(player, response.message or "Failed to check player status")
	end,

	ban = function(player, args)
		if not args[1] then
			ShowMessage(player, "❌ Usage: /gk ban <player> <reason>")
			return
		end

		local targetName = args[1]
		local target = Players:FindFirstChild(targetName)

		if not target then
			ShowMessage(player, "❌ Player not found: " .. targetName)
			return
		end

		local reason = table.concat(args, " ", 2) or "No reason provided"

		SendCommandToAPI("ban", args, player)
		BanPlayer(target, reason, 0)
		ShowMessage(player, "✅ Banned " .. targetName)
	end,

	unban = function(player, args)
		if not args[1] then
			ShowMessage(player, "❌ Usage: /gk unban <player>")
			return
		end

		local response = SendCommandToAPI("unban", args, player)

		local targetName = args[1]
		for userId, _ in pairs(BannedPlayers) do
			if BannedPlayers[userId].Username == targetName then
				BannedPlayers[userId] = nil
				break
			end
		end

		ShowMessage(player, response.message or ("✅ Unbanned " .. args[1]))
	end,

	kick = function(player, args)
		if not args[1] then
			ShowMessage(player, "❌ Usage: /gk kick <player> <reason>")
			return
		end

		local targetName = args[1]
		local target = Players:FindFirstChild(targetName)

		if not target then
			ShowMessage(player, "❌ Player not found: " .. targetName)
			return
		end

		local reason = table.concat(args, " ", 2) or "No reason provided"

		SendCommandToAPI("kick", args, player)
		KickPlayer(target, reason)
		ShowMessage(player, "✅ Kicked " .. targetName)
	end,

	warn = function(player, args)
		if not args[1] or not args[2] then
			ShowMessage(player, "❌ Usage: /gk warn <player> <reason>")
			return
		end

		local response = SendCommandToAPI("warn", args, player)
		ShowMessage(player, response.message or ("⚠️ Warned " .. args[1]))
	end,

	whitelist = function(player, args)
		if not args[1] or not args[2] then
			ShowMessage(player, "❌ Usage: /gk whitelist <add/remove> <player>")
			return
		end

		local response = SendCommandToAPI("whitelist", args, player)
		ShowMessage(player, response.message or "Whitelist updated")
	end,

	reset = function(player, args)
		if not args[1] then
			ShowMessage(player, "❌ Usage: /gk reset <player>")
			return
		end

		local targetName = args[1]
		local target = Players:FindFirstChild(targetName)

		if not target or not PlayerData[target.UserId] then
			ShowMessage(player, "❌ Player not found: " .. targetName)
			return
		end

		PlayerData[target.UserId].speedViolations = 0
		PlayerData[target.UserId].teleportViolations = 0
		PlayerData[target.UserId].jumpViolations = 0
		PlayerData[target.UserId].healthViolations = 0

		ShowMessage(player, "✅ Reset violations for " .. targetName)
		Log(string.format("Violations reset for %s by %s", targetName, player.Name), "INFO")
	end
}

local function HandleCommand(player, message)
	if not string.sub(message, 1, #CommandPrefix) == CommandPrefix then
		return
	end

	if not Config.IsAdmin(player.UserId) then
		ShowMessage(player, "❌ You don't have permission to use this command")
		return
	end

	local args = {}
	for word in string.gmatch(message, "%S+") do
		table.insert(args, word)
	end

	table.remove(args, 1)

	if #args == 0 then
		Commands.help(player, {})
		return
	end

	local commandName = args[1]:lower()
	table.remove(args, 1)

	if Commands[commandName] then
		Commands[commandName](player, args)
	else
		ShowMessage(player, "❌ Unknown command: " .. commandName .. "\nUse /gk help for available commands")
	end
end

