			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
    Game Killers Security™ - API Key Tester
    Version: 2.5.3
    
    This script tests your API connection and validates your API key.
    Run this once to verify your setup, then you can delete it.
]]

local HttpService = game:GetService("HttpService")

-- Import Configuration
local Config = require(script.Parent.Configuration)

print("\n" .. string.rep("=", 60))
print("🛡️  GAME KILLERS SECURITY™ - API KEY TESTER")
print(string.rep("=", 60))

-- Check if API key is set
if not Config.API_KEY or Config.API_KEY == "" or Config.API_KEY == "YOUR_API_KEY_HERE" then
	warn("\n❌ API KEY NOT CONFIGURED!")
	warn("\n📋 To get your API key:")
	warn("   1. Visit: https://www.gamekillersecuritybot.com/dashboard")
	warn("   2. Login with Discord")
	warn("   3. Select your server")
	warn("   4. Copy your API key")
	warn("   5. Paste it into Configuration.lua (line 27)")
	warn("\n" .. string.rep("=", 60) .. "\n")
	return
end

print("\n✅ API Key found: " .. string.sub(Config.API_KEY, 1, 20) .. "...")

-- Test API connection
print("\n🔄 Testing API connection...")
print("   Endpoint: " .. Config.API_URL)

local success, result = pcall(function()
	local url = Config.API_URL .. "/api/health"
	local response = HttpService:GetAsync(url)
	return HttpService:JSONDecode(response)
end)

if success then
	print("✅ API Server is online!")
	print("   Status: " .. (result.status or "unknown"))
	print("   Uptime: " .. math.floor((result.uptime or 0) / 60) .. " minutes")
else
	warn("❌ Failed to connect to API server!")
	warn("   Error: " .. tostring(result))
	warn("\n🔍 Troubleshooting:")
	warn("   1. Check if HttpService is enabled (Game Settings > Security)")
	warn("   2. Verify the API URL in Configuration.lua")
	warn("   3. Check your internet connection")
	warn("   4. Contact support at discord.gg/gamekilllers")
	print("\n" .. string.rep("=", 60) .. "\n")
	return
end

-- Test API key validation
print("\n🔄 Testing API key validation...")

success, result = pcall(function()
	local url = Config.API_URL .. "/api/roblox/startup"
	local data = HttpService:JSONEncode({
		gameId = game.GameId,
		placeId = game.PlaceId,
		gameName = game.Name,
		version = "2.5.3",
		timestamp = os.time(),
		apiKey = Config.API_KEY
	})

	local response = HttpService:PostAsync(url, data, Enum.HttpContentType.ApplicationJson)
	return HttpService:JSONDecode(response)
end)

if success and result.success then
	print("✅ API Key is valid!")
	print("   Guild ID: " .. (result.guildId or "unknown"))
	print("   Server Time: " .. (result.serverTime or "unknown"))
	print("\n🎉 SUCCESS! Your plugin is properly configured!")
	print("   You can now delete this APIKey script.")
else
	warn("❌ API Key validation failed!")
	if result and result.error then
		warn("   Error: " .. result.error)
	else
		warn("   Error: " .. tostring(result))
	end
	warn("\n🔍 Troubleshooting:")
	warn("   1. Make sure you copied the complete API key")
	warn("   2. Verify your Discord server is linked to the bot")
	warn("   3. Check if the API key has expired")
	warn("   4. Generate a new API key from the dashboard")
	warn("   5. Contact support at discord.gg/gamekilllers")
end

-- Test command endpoint
print("\n🔄 Testing command endpoint...")

success, result = pcall(function()
	local url = Config.API_URL .. "/api/roblox/command"
	local data = HttpService:JSONEncode({
		command = "stats",
		args = {},
		userId = 0,
		username = "APIKeyTester",
		gameId = game.GameId,
		apiKey = Config.API_KEY
	})

	local response = HttpService:PostAsync(url, data, Enum.HttpContentType.ApplicationJson)
	return HttpService:JSONDecode(response)
end)

if success and result.success then
	print("✅ Command system working!")
	print("   Response: " .. string.sub(result.message or "", 1, 50) .. "...")
else
	warn("⚠️ Command endpoint test failed (non-critical)")
	warn("   Commands may still work in-game")
end

-- Configuration summary
print("\n" .. string.rep("=", 60))
print("📊 CONFIGURATION SUMMARY")
print(string.rep("=", 60))
print("Sensitivity: " .. Config.SENSITIVITY)
print("Auto-Ban: " .. tostring(Config.AUTO_BAN))
print("Discord Alerts: " .. tostring(Config.DISCORD_ALERTS))
print("Speed Detection: " .. tostring(Config.DETECT_SPEED))
print("Teleport Detection: " .. tostring(Config.DETECT_TELEPORT))
print("Jump Detection: " .. tostring(Config.DETECT_JUMP))
print("Health Detection: " .. tostring(Config.DETECT_HEALTH))
print("Max Violations: " .. Config.MAX_VIOLATIONS)
print("Check Interval: " .. Config.CHECK_INTERVAL .. " seconds")

if #Config.WHITELIST > 0 then
	print("Whitelisted Users: " .. #Config.WHITELIST)
end

if #Config.ADMIN_IDS > 0 then
	print("Admin Users: " .. #Config.ADMIN_IDS)
end

print(string.rep("=", 60))

-- Final instructions
print("\n📝 NEXT STEPS:")
print("   1. ✅ Your plugin is configured and ready!")
print("   2. 🗑️  You can delete this APIKey script now")
print("   3. 🎮 Test the plugin by playing your game")
print("   4. 📊 Monitor threats at: " .. Config.API_URL:gsub("http://", "https://www.") .. "/dashboard")
print("   5. 💬 Use /gk help in-game for commands")
print("\n" .. string.rep("=", 60) .. "\n")

-- Auto-delete script after 10 seconds (optional - comment out if you want to keep it)
task.delay(10, function()
	warn("🗑️  Auto-deleting APIKey tester in 10 seconds...")
	warn("    (This is normal - the test is complete)")
	wait(10)
	if script and script.Parent then
		script:Destroy()
		print("✅ APIKey tester removed. Your plugin is ready!")
	end
end)]]></ProtectedString>
