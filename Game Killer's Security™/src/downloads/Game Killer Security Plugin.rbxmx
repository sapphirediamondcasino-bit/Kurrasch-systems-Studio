	dismissBtn.BackgroundColor3 = Color3.fromRGB(168, 85, 247)
	dismissBtn.BorderSizePixel = 0
	dismissBtn.Text = "I'll Configure It Later"
	dismissBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	dismissBtn.TextSize = 16
	dismissBtn.Font = Enum.Font.GothamBold
	dismissBtn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = dismissBtn

	dismissBtn.MouseButton1Click:Connect(function()
		setupGui:Destroy()
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		local playerGui = player:FindFirstChild("PlayerGui")
		if playerGui then
			setupGui:Clone().Parent = playerGui
		end
	end

	Players.PlayerAdded:Connect(function(player)
		player:WaitForChild("PlayerGui")
		task.wait(1)
		setupGui:Clone().Parent = player.PlayerGui
	end)

	warn("[Game Killers Security] ⚠️ SETUP REQUIRED: API key not configured!")
	warn("[Game Killers Security] Get your key at: https://www.gamekillersecuritybot.com/dashboard")
	warn("[Game Killers Security] Security features are LIMITED until configuration is complete.")
end

-- ========================================
-- INITIALIZE
-- ========================================

Log("=== Game Killers Security™ v2.5.3 ===", "INFO")
Log("Initializing security systems...", "INFO")

if not API_KEY or API_KEY == "YOUR_API_KEY_HERE" or API_KEY == "" then
	warn("[Game Killers Security] ⚠️ API Key not configured!")
	warn("[Game Killers Security] Plugin will run in OFFLINE mode with limited features.")
	warn("[Game Killers Security] Get your API key from: https://www.gamekillersecuritybot.com/dashboard")
	PromptForAPIKey()

	Log("Running in OFFLINE mode - Basic exploit detection only", "WARN")
	Log("Discord integration, commands, and ban sync are DISABLED", "WARN")
else
	if Config.Validate() then
		Log("Configuration validated successfully!", "INFO")

		-- Send startup notification
		local startupResponse = SendToAPI("/api/roblox/startup", {
			gameId = game.GameId,
			placeId = game.PlaceId,
			gameName = game.Name,
			maxPlayers = Players.MaxPlayers,
			timestamp = os.time(),
			version = "2.5.3"
		})

		if startupResponse and startupResponse.success then
			Log("✅ Connected to Discord bot successfully!", "INFO")
			Log("Guild ID: " .. tostring(startupResponse.guildId), "INFO")
		else
			warn("[Game Killers Security] Failed to connect to Discord bot")
			warn("[Game Killers Security] Check your API key and internet connection")
		end
	else
		warn("[Game Killers Security] ❌ Configuration validation failed! Check your settings.")
	end
end

-- Connect events
Players.PlayerAdded:Connect(OnPlayerAdded)
Players.PlayerRemoving:Connect(OnPlayerRemoving)

-- Handle existing players
for _, player in ipairs(Players:GetPlayers()) do
	OnPlayerAdded(player)
end

-- Admin command listener
Players.PlayerAdded:Connect(function(player)
	player.Chatted:Connect(function(message)
		HandleCommand(player, message)
	end)
end)

-- Handle existing players for commands
for _, player in ipairs(Players:GetPlayers()) do
	player.Chatted:Connect(function(message)
		HandleCommand(player, message)
	end)
end

if API_KEY and API_KEY ~= "YOUR_API_KEY_HERE" and API_KEY ~= "" then
	Log("🛡️ Security systems online and protecting your game!", "INFO")
	Log("💬 Commands ready! Type /gk help in chat for available commands", "INFO")
	Log("📊 Monitor threats at: https://www.gamekillersecuritybot.com/dashboard", "INFO")
else
	Log("⚠️ Running in OFFLINE mode - Configure API key for full features", "WARN")
end]]></ProtectedString>
